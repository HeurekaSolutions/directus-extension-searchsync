{
	"name": "@heurekasolutions/directus-extension-searchsync",
	"description": "A directus 11 compatible sync extension for meilisearch indexing",
	"license": "GPL-3.0",
	"author": {
		"email": "derskillbaumapfel@gmail.com",
		"name": "DerSkillBaumApfel"
	},
	"icon": "extension",
	"version": "1.0.0",
	"homepage": "https://github.com/HeurekaSolutions/directus-extension-searchsync",
	"publishConfig": {
		"registry": "https://npm.pkg.github.com/"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HeurekaSolutions/directus-extension-searchsync.git"
	},
	"bugs": {
		"url": "https://github.com/HeurekaSolutions/directus-extension-searchsync/issues"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-custom-hook",
		"meilisearch",
		"searchsync",
		"search engine",
		"indexing"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "hook",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^11.14"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"dependencies": {
		"axios": "^1.6.5",
		"striptags": "^3.2.0"
	},
	"devDependencies": {
		"@directus/errors": "^2.1.0",
		"@directus/extensions-sdk": "17.0.4",
		"@types/node": "^25.0.3",
		"typescript": "^5.9.3"
	}
}